Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

/* The transcript draws no scrollbar: its foot is the composer, and the wheel and
   the page keys are how it moves. See docs/tui.md#mouse. */
#transcript {
    height: 1fr;
    width: 1fr;
    padding: 0 2;
    scrollbar-size-vertical: 0;
}

#transcript:focus {
    border: none;
}

.transcript-message, .transcript-stream {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

.transcript-welcome {
    width: 54;
    max-width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: round $border-blurred;
}

.welcome-tip {
    width: 1fr;
    height: auto;
    margin: 1 1 2 1;
    color: $text-muted;
    text-style: dim;
}

#unread {
    display: none;
    height: 1;
    padding: 0 2;
    color: $accent;
    text-align: right;
}

/* The queued-prompt preview: the composer area grows to show it, because it is
   part of the composer rather than something floating over the transcript. */
#queue {
    display: none;
    height: auto;
    max-height: 6;
    padding: 0 2;
}

/* The command palette floats directly above the composer. `overlay: screen`
   takes it out of the flow altogether, so opening it cannot take height from
   the transcript, and the offset lifts it by its own height to sit on the
   composer's top edge. The background keeps the transcript behind it legible. */
#suggestions {
    display: none;
    overlay: screen;
    offset-y: -100%;
    height: auto;
    max-height: 8;
    margin: 0 1;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
    text-style: dim;
}

#composer {
    height: auto;
    min-height: 3;
    max-height: 8;
    margin: 0 2;
    padding: 0 1;
    border: round $border-blurred;
}

#composer:focus {
    border: round $border;
}

#status {
    height: auto;
    min-height: 1;
    max-height: 4;
    padding: 0 2;
    color: $text-muted;
}
