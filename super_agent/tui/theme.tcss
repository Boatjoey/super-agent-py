Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

#transcript {
    height: 1fr;
    width: 1fr;
    padding: 0 2;
    scrollbar-gutter: stable;
}

#transcript:focus {
    border: none;
}

.transcript-welcome, .transcript-message, .transcript-stream {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#unread {
    display: none;
    height: 1;
    padding: 0 2;
    color: $accent;
    text-align: right;
}

#suggestions {
    display: none;
    height: auto;
    max-height: 8;
    padding: 0 2;
    color: $text-muted;
    text-style: dim;
}

#composer {
    height: auto;
    min-height: 3;
    max-height: 8;
    margin: 0 1;
    border: round $border-blurred;
}

#composer:focus {
    border: round $border;
}

#status {
    height: auto;
    min-height: 1;
    max-height: 4;
    padding: 0 2;
    color: $text-muted;
}
